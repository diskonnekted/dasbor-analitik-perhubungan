@echo off
powershell -NoProfile -Command "$a = Get-Content 'I:\perhubungan\public\lapor_ruas.geojson' -Raw | ConvertFrom-Json; $b = Get-Content 'I:\perhubungan\public\pju_ruas.geojson' -Raw | ConvertFrom-Json; Write-Host ('lapor_ruas: ' + $a.features.Count + ' ruas'); Write-Host ('pju_ruas  : ' + $b.features.Count + ' ruas'); Write-Host '---'; $a.features[0..1] | ForEach-Object { Write-Host ('  lapor: ' + $_.properties.nomor_ruas + ' - ' + $_.properties.nama_ruas) }; $b.features[0..1] | ForEach-Object { Write-Host ('  pju  : ' + $_.properties.nomor_ruas + ' - ' + $_.properties.nama_ruas) }"
